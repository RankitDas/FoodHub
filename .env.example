# Public production URL used for metadata, sitemap, and robots.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Set this to true only on hosts that cannot run Next.js image optimization.
NEXT_PUBLIC_DISABLE_IMAGE_OPTIMIZATION=false

# Optional Supabase configuration for future backend integration.
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
